# Git-tracked, audited runtime versions. Keep software versions out of .env so
# user secrets/configuration can be backed up and restored without silently
# pinning an old application release.
STACK_RELEASE=0.1.0-rc6
OLLAMA_IMAGE=ollama/ollama:0.34.4
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.4
DOCLING_IMAGE=ghcr.io/docling-project/docling-serve:v1.35.0
MAINTENANCE_IMAGE=alpine:3.22.1
SMOKE_IMAGE=curlimages/curl:8.16.0
