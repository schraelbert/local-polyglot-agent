# UI
WEBUI_NAME="Local Polyglot Agent"
WEBUI_PORT=3000
WEBUI_SECRET_KEY=replace-me-with-a-random-secret
WEBUI_ADMIN_EMAIL=admin@local.invalid
WEBUI_ADMIN_PASSWORD=replace-me-with-a-random-admin-password
WEBUI_ADMIN_NAME="Local Admin"

# Models
# Multilingual conversation anchor and translation-tool model for 16 GB Macs. Qwen3.5 9B Q4_K_M is ~6.6 GB.
CHAT_MODEL=qwen3.5:9b-q4_K_M
# Chinese-first conversation anchor for the standard 16 GB tier. Qwen2.5 7B is compact, Chinese-strong, and Apache-2.0.
KNOWLEDGE_CHAT_MODEL=qwen2.5:7b
# Higher-capability tier selected automatically only on hosts/VMs with enough RAM.
HIGH_MEMORY_CHAT_MODEL=qwen3:14b
HIGH_MEMORY_KNOWLEDGE_CHAT_MODEL=qwen3:14b
# Hardware thresholds for automatic text-tier selection.
STANDARD_VM_THRESHOLD_GIB=10
HIGH_MEMORY_HOST_THRESHOLD_GIB=24
HIGH_MEMORY_VM_THRESHOLD_GIB=14
# Optional override for make up / make disk-check free-space preflight. Leave unset for automatic 30 GiB fresh-pull / 16 GiB steady-state thresholds.
# COLIMA_MIN_FREE_DISK_GIB=30
# Smaller multimodal model used only when a request actually contains images.
VISION_CHAT_MODEL=qwen3-vl:4b-instruct
# Public model exposed to Open WebUI; model-router keeps normal text conversations on a sticky anchor and dispatches only explicit tools internally.
AGENT_MODEL=polyglot-agent:latest
# Hidden Chinese-conversation and vision agents. Keep all three agent tags distinct.
KNOWLEDGE_AGENT_MODEL=polyglot-agent-knowledge:latest
VISION_AGENT_MODEL=polyglot-agent-vision:latest
EMBEDDING_MODEL=bge-m3
# Accelerator context preference. CPU runtime is capped separately below.
OLLAMA_CONTEXT_LENGTH=16384
# Memory-safe context used automatically when no usable Ollama GPU runner exists.
OLLAMA_CPU_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_NO_CLOUD=1
OLLAMA_DEBUG=0
# Sticky-conversation profile uses direct mode by default. Explicit client think=true is preserved only when the multilingual Qwen anchor/translation route is active.
TEXT_THINKING_DEFAULT=false
# Hidden contextual-translation resolver budget / safety cap.
CONTEXT_RESOLVE_NUM_PREDICT=1024
CONTEXT_SOURCE_MAX_CHARS=12000

# Local exact-text corpus for contextual whole-work translation. First provision
# downloads and indexes the upstream MIT repository into a named SQLite volume;
# normal later starts reuse the local copy and do not need corpus network access.
LITERATURE_CORPUS_URL=https://codeload.github.com/open-chinese/poetry-collection/tar.gz/refs/heads/main
LITERATURE_CORPUS_SOURCE=open-chinese/poetry-collection
LITERATURE_CORPUS_REV=1
LITERATURE_CORPUS_MIN_WORKS=100000
FORCE_LITERATURE_CORPUS_UPDATE=0

# Debug-only host ports. Base Compose exposes neither Ollama nor Docling.
OLLAMA_PORT=11434
DOCLING_PORT=5001

# Document parsing
DOCLING_API_KEY=replace-me-with-a-random-secret
DOCLING_MAX_SYNC_WAIT=600
DOCLING_WORKERS=1
DOCLING_THREADS=4
DOCLING_ENABLE_UI=false
# Bump when the prefetched Docling artifact set changes.
DOCLING_PREFETCH_REV=3
# Resource-safety defaults; raise deliberately for very large documents.
DOCLING_MAX_NUM_PAGES=1000
DOCLING_MAX_FILE_SIZE=262144000
DOCLING_PARAMS={"do_ocr":true,"force_ocr":false,"ocr_preset":"rapidocr","pdf_backend":"docling_parse","table_mode":"accurate","pipeline":"standard"}

# Deterministic RAG profile sized to fit the conservative 4K CPU fallback. Open WebUI stores
# many document settings as ConfigVars; disabling persistent config makes the
# repository/environment authoritative across restarts and upgrades.
ENABLE_PERSISTENT_CONFIG=false
RAG_TEXT_SPLITTER=character
ENABLE_MARKDOWN_HEADER_TEXT_SPLITTER=true
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_FILE_MAX_SIZE=250
RAG_FILE_MAX_COUNT=10

# Privacy / reduced surface
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
ENABLE_VERSION_UPDATE_CHECK=false
ENABLE_WEB_SEARCH=false
ENABLE_CODE_EXECUTION=false
# Open WebUI 0.10+ injects built-in agentic tools by default in Native mode.
# This curated local assistant deliberately disables them; File Context/RAG remains available.
ENABLE_PLUGINS=false
DEFAULT_MODEL_METADATA={"capabilities":{"builtin_tools":false,"file_context":true},"builtinTools":{"tasks":false}}

# Local logging limits
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# Smoke tests
# Set to 1 in release validation when Apple GPU acceleration is mandatory.
SMOKE_REQUIRE_GPU=0
SMOKE_HTTP_TIMEOUT=20
SMOKE_MODEL_TIMEOUT=300
SMOKE_DOCLING_TIMEOUT=600
